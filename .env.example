RESEND_API_KEY=
PURCHASE_REQUEST_FROM=AbilityMade <orders@abilitymade.net>
PURCHASE_REQUEST_TO=AbilityMade@gmail.com

# Stripe hosted Checkout. Leave live payments disabled until the launch checks pass.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_SITE_URL=http://localhost:3000
STRIPE_LIVE_ENABLED=false
# Absolute private directory OUTSIDE the repository. On Railway mount a volume at /data.
ORDER_DATA_DIR=
# US-only; merchandise subtotal >= 12000 cents receives free standard shipping.
# Approved policy: one $10 fee per order below $120, including multiple suppliers.
# Apply to Railway only with explicit authorization; this example changes no deployment.
SHIPPING_FLAT_RATE_CENTS=1000
# Keep automatic tax disabled as currently instructed; review tax treatment before launch.
STRIPE_AUTOMATIC_TAX=false

# Optional stable payment namespace; defaults to Railway environment name or local.
# Keep unchanged for existing orders. Use staging or production as appropriate.
PAYMENT_ENVIRONMENT=
